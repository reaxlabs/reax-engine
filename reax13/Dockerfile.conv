FROM reax13-base
RUN pip install --no-cache-dir 'ninja==1.13.2' 'nvidia-cuda-cccl==13.0.85'
RUN CAUSAL_CONV1D_FORCE_BUILD=TRUE MAX_JOBS=4 CUDA_HOME=/usr/local/cuda TORCH_CUDA_ARCH_LIST=12.0 pip install --no-cache-dir --no-build-isolation --no-deps 'causal-conv1d==1.7.0'
RUN python -c 'import causal_conv1d, torch; print(causal_conv1d.__version__, torch.__version__)'

RUN pip install --no-cache-dir 'httpx==0.28.1'

COPY . /engine
ENV PYTHONPATH=/engine
WORKDIR /engine
